{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "shivam-Project-EHIP"
		},
		"LS_EHIP_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_EHIP_ADLS'"
		},
		"LS_EHIP_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_EHIP_AzureSQL'"
		},
		"LS_EHIP_Databricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'LS_EHIP_Databricks'"
		},
		"LS_EHIP_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ehipdatalake.dfs.core.windows.net/"
		},
		"LS_EHIP_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "projectehip.database.windows.net"
		},
		"LS_EHIP_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "EHIP_1ST_DB"
		},
		"LS_EHIP_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "projectehip"
		},
		"LS_EHIP_Databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0829-173139-sqmraarl"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "shivam-Project-EHIP_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_EHIP_ADLS_accountKey": {
						"value": "[parameters('LS_EHIP_ADLS_accountKey')]"
					},
					"LS_EHIP_AzureSQL_password": {
						"value": "[parameters('LS_EHIP_AzureSQL_password')]"
					},
					"LS_EHIP_Databricks_accessToken": {
						"value": "[parameters('LS_EHIP_Databricks_accessToken')]"
					},
					"LS_EHIP_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_EHIP_ADLS_properties_typeProperties_url')]"
					},
					"LS_EHIP_AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_EHIP_AzureSQL_properties_typeProperties_server')]"
					},
					"LS_EHIP_AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_EHIP_AzureSQL_properties_typeProperties_database')]"
					},
					"LS_EHIP_AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_EHIP_AzureSQL_properties_typeProperties_userName')]"
					},
					"LS_EHIP_Databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_EHIP_Databricks_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}